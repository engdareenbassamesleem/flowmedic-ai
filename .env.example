N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
DATABASE_URL=sqlite:///./flowmedic.db
REQUEST_TIMEOUT=15
# Without an AI key, deterministic mock diagnosis is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional API bearer token; set before exposing beyond localhost.
FLOWMEDIC_API_KEY=
# Seeds one synthetic, non-sensitive incident with deterministic mock diagnosis.
# Do not enable with N8N_API_KEY or AI_API_KEY.
DEMO_MODE=false
# Comma-separated frontend origins allowed to call the API in development.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Read-only n8n monitoring. Disabled unless N8N_BASE_URL and N8N_API_KEY are both configured.
MONITOR_POLL_INTERVAL_SECONDS=60
MONITOR_PAGE_SIZE=50
# Fresh pages are checked every cycle; this bounds older-page backfill work.
MONITOR_BACKFILL_PAGES_PER_CYCLE=1
# SQLite-backed ownership lease for deployments with multiple API processes.
MONITOR_LEASE_SECONDS=120
MONITOR_MAX_RETRIES=3
MONITOR_RETRY_BASE_SECONDS=2
# Retained history powers recent health metrics. Incidents are never removed by this cleanup.
EXECUTION_HISTORY_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
RETENTION_CLEANUP_BATCH_SIZE=500
